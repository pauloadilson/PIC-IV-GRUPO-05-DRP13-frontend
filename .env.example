# URL principal da API do Backend (local ou producao)
VITE_API_URL=

# URLs do Backend na Vercel (opcional, separadas por virgula)
VITE_VERCEL_BACKEND_URLS=

# URL local do Backend para ambiente de desenvolvimento
VITE_LOCAL_BACKEND_URL=

# Chave de seguranca enviada no cabecalho X-API-Key para o Backend (mesmo valor de BACKEND_API_KEY)
VITE_BACKEND_API_KEY=
